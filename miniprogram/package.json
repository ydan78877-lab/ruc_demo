{
  "name": "ruc-suzhou-student-miniprogram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "import:cases": "node scripts/import-case-csv.mjs",
    "build:h5": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "build:all": "npm run check && npm run build:h5 && npm run build:weapp",
    "dev:h5": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "preview": "npm run dev:h5",
    "check": "tsc --noEmit && node scripts/validate-project.mjs",
    "check:sync": "npm run check && npm run build:h5 && npm run build:weapp && npm run check"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.2",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "18.3.28",
    "@types/webpack-env": "1.18.8",
    "babel-preset-taro": "4.2.1",
    "react-refresh": "0.14.2",
    "typescript": "5.9.3",
    "webpack": "5.91.0"
  }
}
