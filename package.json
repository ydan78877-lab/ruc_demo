{
  "name": "baoyan-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:demo": "bash scripts/sync-demo.sh",
    "dev": "vite --config web/vite.config.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "dev:miniprogram": "npm --prefix miniprogram run dev:h5",
    "build": "npm run build:web && npm run build:admin",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts && node web/scripts/prepare-sites-build.mjs",
    "build:admin": "tsc -p admin/tsconfig.json && vite build --config admin/vite.config.ts",
    "build:miniprogram": "npm --prefix miniprogram run build:all",
    "check:miniprogram": "npm --prefix miniprogram run check:sync",
    "test": "playwright test -c config/playwright.config.ts",
    "test:sites": "node --test web/tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.44.7",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
